# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_db
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@db:5432/invoice_db
UPLOAD_DIR=/app/uploads
ARTIFACT_DIR=/app/artifacts
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Each provider uses one API key across extraction, vision, and OCR cleanup.
LLM_PROVIDER=openai
# Blank model values use the selected provider's default model.
EXTRACTION_MODEL=
# Blank provider values inherit LLM_PROVIDER.
VISION_PROVIDER=
VISION_MODEL=
ENABLE_VISION_FALLBACK=true
OCR_CLEANUP_PROVIDER=
OCR_CLEANUP_MODEL=
ENABLE_OCR_CLEANUP=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
OCR_LANGUAGES=eng
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_FILE_SIZE_BYTES=26214400
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=40000000
